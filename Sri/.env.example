# =============================================================================
# SRI HOMOEO CARE — ENVIRONMENT TEMPLATE (copy to .env — never commit .env)
# =============================================================================

# Database (required in production — use a least-privilege user, not root)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="sri_app_user"
MYSQL_PASSWORD="your_secure_db_password"
MYSQL_DATABASE="sri_homoeo_clinic"
MYSQL_SSL="false"
# Optional URI form (overrides discrete MYSQL_* when set)
# DATABASE_URL="mysql://sri_app_user:password@localhost:3306/sri_homoeo_clinic"

# Public clinic info (safe to expose to client)
VITE_CLINIC_NAME="Sri Homoeo Care"
VITE_CLINIC_PHONE="+91 94432 00000"
VITE_CLINIC_HOURS="Daily 6:00 PM – 8:00 PM IST"
VITE_APP_URL="https://srihomoeocare.onvoroa.com"

# Optional SMS / email providers (leave empty if unused)
MSG91_AUTH_KEY=""
MSG91_WIDGET_ID=""
MSG91_TEMPLATE_ID=""
MSG91_TOKEN_AUTH=""
MSG91_SENDER_ID="SRICLN"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Sri Homoeo Care <noreply@yourdomain.com>"
