# =============================================================================
# SRI HOMOEO CARE — Voroa / PostgreSQL environment
# Copy to .env — never commit real secrets
# =============================================================================

NODE_ENV=production
PORT=3000
NITRO_PRESET=node-server

# Preferred: full URL from Voroa Postgres dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Or discrete vars (if DATABASE_URL is not set)
# PGHOST="..."
# PGPORT="5432"
# PGUSER="..."
# PGPASSWORD="..."
# PGDATABASE="sri_homoeo_clinic"
# PGSSL="true"

# Public clinic info
VITE_CLINIC_NAME="Sri Homoeo Care"
VITE_CLINIC_PHONE="+91 94432 00000"
VITE_CLINIC_HOURS="Daily 6:00 PM – 8:00 PM IST"
VITE_APP_URL="https://srihomoeocare.onvoroa.com"

# Optional observability
VITE_SENTRY_DSN=""
SENTRY_DSN=""

# E2E Testing
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
